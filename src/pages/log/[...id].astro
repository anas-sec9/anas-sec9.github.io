---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Article from '../../layouts/Article.astro';
import { readingTime } from '../../lib/url';

export const getStaticPaths = (async () => {
  const entries = await getCollection('log');
  return entries
    .filter((e) => !e.data.draft)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Article
  title={entry.data.title}
  summary={entry.data.summary}
  date={entry.data.date}
  kicker={entry.data.track ? `Build log — ${entry.data.track}` : 'Build log'}
  readingTime={readingTime(entry.body)}
  tags={entry.data.tags}
  headings={headings}
  backHref="/log"
  backLabel="All log entries"
>
  <Content />
</Article>
