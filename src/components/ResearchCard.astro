---
import { href, fmtStamp } from '../lib/url';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  summary: string;
  date: Date;
  malware?: string;
  tags?: string[];
  n?: string;
  /** `feature` is the oversized homepage lead. */
  variant?: 'feature' | 'card' | 'row';
}

const { id, title, subtitle, summary, date, malware, tags = [], n, variant = 'card' } = Astro.props;
const url = href(`/research/${id}`);
---

{
  variant === 'feature' && (
    <a href={url} class="feat">
      <div class="feat__rail">
        <span class="feat__n mono">{n ?? '01'}</span>
        <span class="feat__line" />
      </div>
      <div class="feat__body">
        <p class="feat__meta mono">
          {fmtStamp(date)}
          {malware && <span class="feat__mal">{malware}</span>}
        </p>
        <h3 class="display feat__title">{title}</h3>
        {subtitle && <p class="feat__sub serif">{subtitle}</p>}
        <p class="feat__sum">{summary}</p>
        <span class="arrow">Read the analysis</span>
      </div>
    </a>
  )
}

{
  variant === 'card' && (
    <a href={url} class="card">
      <div class="card__top">
        <span class="card__n mono">{n}</span>
        <span class="card__date mono">{fmtStamp(date)}</span>
      </div>
      <h3 class="card__title serif">{title}</h3>
      <p class="card__sum">{summary}</p>
      <div class="card__foot">
        {malware && <span class="badge badge--accent">{malware}</span>}
        {tags.slice(0, 2).map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    </a>
  )
}

{
  variant === 'row' && (
    <a href={url} class="rowitem">
      <span class="rowitem__date mono">{fmtStamp(date)}</span>
      <span class="rowitem__body">
        <span class="rowitem__title serif">{title}</span>
        <span class="rowitem__sum">{summary}</span>
      </span>
      {malware && <span class="badge rowitem__badge">{malware}</span>}
    </a>
  )
}

<style>
  /* ═══ Feature ═══ */
  .feat {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-6) 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    transition: background var(--dur) var(--ease);
  }

  .feat:hover {
    background: linear-gradient(90deg, var(--accent-wash), transparent 60%);
  }

  .feat__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
  }

  .feat__n {
    font-size: 0.8rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .feat__line {
    flex: 1;
    width: 1px;
    background: linear-gradient(var(--accent-line), transparent);
  }

  .feat__meta {
    font-size: var(--t-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-4);
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .feat__mal {
    color: var(--accent);
  }

  .feat__mal::before {
    content: '· ';
    color: var(--ink-4);
  }

  .feat__title {
    margin-top: var(--s-3);
    font-size: var(--t-display);
    font-weight: 500;
    color: var(--ink);
    max-width: 20ch;
    text-wrap: balance;
  }

  .feat__sub {
    margin-top: var(--s-4);
    font-size: var(--t-lead);
    font-style: italic;
    font-weight: 300;
    color: var(--ink-2);
    max-width: 46ch;
    line-height: 1.45;
  }

  .feat__sum {
    margin-top: var(--s-4);
    color: var(--ink-3);
    max-width: 58ch;
    font-size: var(--t-sm);
    line-height: 1.7;
  }

  .feat .arrow {
    margin-top: var(--s-5);
  }

  /* ═══ Card ═══ */
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--s-5);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--bg-raised);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease), background var(--dur) var(--ease);
    height: 100%;
  }

  .card:hover {
    border-color: var(--accent-line);
    background: var(--bg-raised-2);
    transform: translateY(-2px);
  }

  .card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--t-2xs);
    letter-spacing: 0.1em;
  }

  .card__n {
    color: var(--accent);
  }

  .card__date {
    color: var(--ink-4);
  }

  .card__title {
    margin-top: var(--s-4);
    font-size: 1.28rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }

  .card__sum {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    line-height: 1.65;
    color: var(--ink-3);
    flex: 1;
  }

  .card__foot {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: center;
  }

  /* ═══ Row ═══ */
  .rowitem {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: var(--s-4) var(--s-3);
    border-bottom: 1px solid var(--line-faint);
    transition: background var(--dur) var(--ease);
  }

  .rowitem:hover {
    background: var(--bg-raised);
  }

  .rowitem__date {
    font-size: var(--t-2xs);
    color: var(--ink-4);
    letter-spacing: 0.06em;
  }

  .rowitem__body {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    min-width: 0;
  }

  .rowitem__title {
    font-size: 1.05rem;
    color: var(--ink);
    line-height: 1.3;
  }

  .rowitem:hover .rowitem__title {
    color: var(--accent);
  }

  .rowitem__sum {
    font-size: var(--t-xs);
    color: var(--ink-3);
    line-height: 1.55;
  }

  .rowitem__badge {
    flex-shrink: 0;
  }

  @media (max-width: 46rem) {
    .feat {
      grid-template-columns: 1fr;
    }
    .feat__rail {
      flex-direction: row;
      align-items: center;
    }
    .feat__line {
      flex: 1;
      height: 1px;
      width: auto;
      background: linear-gradient(90deg, var(--accent-line), transparent);
    }
    .rowitem {
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }
    .rowitem__badge {
      justify-self: start;
    }
  }
</style>
