---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/base.css';
import { site } from '../site.config';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Page-level article metadata for OG. */
  type?: 'website' | 'article';
  date?: Date;
}

const { title, description = site.description, type = 'website', date } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.author.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author.name} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={site.name} />
<meta property="og:url" content={canonical} />
{date && <meta property="article:published_time" content={date.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />

<meta name="theme-color" content="#0a0b0d" />
<meta name="color-scheme" content="dark" />

<link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={site.name} href={href('/rss.xml')} />
