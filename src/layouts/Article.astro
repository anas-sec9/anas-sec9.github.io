---
import Base from './Base.astro';
import Attack from '../components/Attack.astro';
import { site } from '../site.config';
import { href, fmtDate, isoDate, fmtStamp } from '../lib/url';
import '../styles/prose.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  subtitle?: string;
  summary: string;
  date: Date;
  updated?: Date;
  kicker?: string;
  readingTime?: string;
  tags?: string[];
  attack?: { id: string; name: string }[];
  headings?: Heading[];
  /** Where this was first published, if syndicated. */
  original?: { label: string; url: string };
  /** Rendered at the very bottom, under the rule. */
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  summary,
  date,
  updated,
  kicker,
  readingTime,
  tags = [],
  attack = [],
  headings = [],
  original,
  backHref = '/research',
  backLabel = 'All research',
} = Astro.props;

const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={summary} type="article" date={date}>
  <article class="art">
    <header class="art__head">
      <div class="wrap">
        <div class="art__headInner">
          {kicker && <p class="kicker kicker--plain art__kicker">{kicker}</p>}

          <h1 class="display art__title">{title}</h1>

          {subtitle && <p class="art__sub serif">{subtitle}</p>}

          <div class="art__meta">
            <span class="mono">{fmtStamp(date)}</span>
            <span class="art__sep" aria-hidden="true">/</span>
            <span>{site.author.name}</span>
            {
              readingTime && (
                <>
                  <span class="art__sep" aria-hidden="true">/</span>
                  <span class="mono">{readingTime} read</span>
                </>
              )
            }
            {
              updated && (
                <>
                  <span class="art__sep" aria-hidden="true">/</span>
                  <span class="mono dim">
                    updated <time datetime={isoDate(updated)}>{fmtStamp(updated)}</time>
                  </span>
                </>
              )
            }
          </div>

          {
            original && (
              <p class="art__original">
                <span class="mono art__originalLabel">First published</span>
                <a href={original.url} class="link" rel="noopener">
                  {original.label}
                </a>
              </p>
            )
          }

          {
            tags.length > 0 && (
              <div class="row art__tags">
                {tags.map((t) => (
                  <a class="tag" href={href(`/tags/${t}`)}>
                    {t}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="wrap art__body">
      <div class="art__grid">
        <div class="art__main">
          <div class="prose">
            <slot />
          </div>

          {
            attack.length > 0 && (
              <div class="art__attack">
                <Attack items={attack} label="ATT&CK coverage" />
              </div>
            )
          }

          <footer class="art__foot">
            <a href={href(backHref)} class="arrow art__back">{backLabel}</a>
          </footer>
        </div>

        {
          toc.length > 2 && (
            <aside class="art__aside">
              <nav class="toc" aria-label="On this page">
                <p class="toc__head">Contents</p>
                <ol class="toc__list">
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} class="toc__link" data-toc={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>
    </div>
  </article>
</Base>

<style>
  .art__head {
    padding-top: clamp(3rem, 1.5rem + 5vw, 6rem);
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(80rem 28rem at 10% -20%, rgba(224, 164, 88, 0.07), transparent 70%),
      var(--bg);
  }

  .art__headInner {
    max-width: 52rem;
  }

  .art__kicker {
    color: var(--accent);
    margin-bottom: var(--s-4);
  }

  .art__title {
    font-size: var(--t-display);
    font-weight: 500;
    color: var(--ink);
    text-wrap: balance;
  }

  .art__sub {
    margin-top: var(--s-4);
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--ink-2);
    font-weight: 300;
    font-style: italic;
    max-width: 46rem;
  }

  .art__meta {
    margin-top: var(--s-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .art__sep {
    color: var(--ink-4);
  }

  .art__original {
    margin-top: var(--s-4);
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--t-xs);
  }

  .art__originalLabel {
    font-size: var(--t-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .art__tags {
    margin-top: var(--s-4);
    gap: var(--s-3);
  }

  .art__body {
    padding-top: var(--s-8);
  }

  .art__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: var(--s-8);
    align-items: start;
  }

  .art__main {
    min-width: 0;
  }

  .art__attack {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .art__foot {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  /* ── Table of contents ── */
  .art__aside {
    position: sticky;
    top: 6rem;
  }

  .toc__head {
    font-family: var(--font-mono);
    font-size: var(--t-2xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-4);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .toc__list {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
    counter-reset: toc;
  }

  .toc__list li {
    counter-increment: toc;
  }

  .toc__link {
    display: block;
    padding: 0.4rem 0 0.4rem 2rem;
    font-size: var(--t-xs);
    line-height: 1.45;
    color: var(--ink-3);
    position: relative;
    transition: color var(--dur) var(--ease);
  }

  .toc__link::before {
    content: counter(toc, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-4);
    top: 0.55rem;
  }

  .toc__link:hover {
    color: var(--ink);
  }

  .toc__link.is-current {
    color: var(--accent);
  }

  .toc__link.is-current::before {
    color: var(--accent);
  }

  @media (max-width: 68rem) {
    .art__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .art__aside {
      display: none;
    }
  }
</style>

<script>
  // Highlight the current section in the TOC.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
  if (links.length) {
    const targets = [...links]
      .map((l) => document.getElementById(l.dataset.toc!))
      .filter(Boolean) as HTMLElement[];

    const setCurrent = (slug: string) => {
      links.forEach((l) => l.classList.toggle('is-current', l.dataset.toc === slug));
    };

    const obs = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );

    targets.forEach((t) => obs.observe(t));
  }
</script>
